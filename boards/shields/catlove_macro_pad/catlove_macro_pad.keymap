#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4
                &kp Q   &kp W   &kp E   &kp R
                &kp A   &kp S   &kp D   &kp F
                &kp ENTER  &kp ESC
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_DN C_VOL_UP
                &inc_dec_kp PG_DN PG_UP
            >;
        };

        layer_1 {
            status = "reserved";
        };

        layer_2 {
            status = "reserved";
        };

        layer_3 {
            status = "reserved";
        };
    };
};
