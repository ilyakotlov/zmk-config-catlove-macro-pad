#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SCROLL 1

// Scroll wheel should react immediately on every encoder detent.
&msc {
    time-to-max-speed-ms = <0>;
};

/ {
    behaviors {
        // Encoder rotation -> mouse wheel.
        // Clockwise (right) = scroll down, counterclockwise (left) = scroll up.
        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp N1  &kp N2  &kp N3     &kp N4
                &kp N5  &kp N6  &kp N7     &kp N8
                &kp N9  &kp N0  &kp MINUS  &mo SCROLL
                &kp C_MUTE
            >;
            // Clockwise: volume up; counterclockwise: volume down.
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans
            >;
            // While the bottom-right key is held: rotate the encoder to scroll.
            sensor-bindings = <&enc_scroll>;
        };
    };
};
