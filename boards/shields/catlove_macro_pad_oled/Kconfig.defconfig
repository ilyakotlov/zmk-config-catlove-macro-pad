if SHIELD_CATLOVE_MACRO_PAD_OLED

config ZMK_KEYBOARD_NAME
    default "Catlove OLED"

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

# SSD1306 is a 1-bit monochrome panel. Without these LVGL defaults LVGL is
# built with 16-bit color, the Zephyr LVGL glue rejects the MONO pixel format
# and the display never initializes.
if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
